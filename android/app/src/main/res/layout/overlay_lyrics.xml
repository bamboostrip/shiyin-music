<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_background"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:elevation="8dp">

    <!-- 窗口宽度已由 LyricsOverlayService 固定（min(屏幕宽*0.9, 320dp)），
         这里填满窗口即可，不再约束文本宽度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:id="@+id/lyrics_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <shiyin.famlife.top.KaraokeTextView
                android:id="@+id/tv_current_lyric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_next_lyric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text=""
                android:textColor="#99FFFFFF"
                android:textSize="13.6sp"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btn_lock"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_lock_idle_lock"
            android:scaleType="centerInside"
            android:tint="#88FFFFFF"
            android:contentDescription="锁定"
            android:padding="4dp" />

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:scaleType="centerInside"
            android:tint="#88FFFFFF"
            android:contentDescription="关闭"
            android:padding="4dp" />

    </LinearLayout>

    <!-- 右下角宽度拖拽手柄：缩小图标并独立占位，不与锁定/关闭按钮重叠；
         拖动时横向调整悬浮窗宽度，宽度记忆保存 -->
    <ImageView
        android:id="@+id/btn_resize"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="4dp"
        android:src="@drawable/overlay_resize_grip"
        android:scaleType="centerInside"
        android:tint="#80FFFFFF"
        android:contentDescription="调整宽度"
        android:padding="5dp" />

</FrameLayout>
